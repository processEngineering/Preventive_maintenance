{
  "name": "mtc-api",
  "version": "0.1.0",
  "private": true,
  "description": "MTC API authentication prototype for PE-SERVER2",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "pm2:start": "pm2 start ecosystem.config.js --only mtc-api --env production",
    "pm2:restart": "pm2 restart mtc-api --update-env",
    "pm2:status": "pm2 status mtc-api",
    "pm2:logs": "pm2 logs mtc-api",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3"
  }
}
